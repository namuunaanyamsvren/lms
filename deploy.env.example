# Copy to deploy.env and fill with real values from the deployment secret manager.
# Never commit deploy.env.

NODE_ENV=production
REQUIRE_INTERNAL_TLS=true

FRONTEND_HTTP_PORT=8080
FRONTEND_URL=https://lms.example.com
ALLOWED_ORIGINS=https://lms.example.com
TENANT_BASE_DOMAIN=lms.example.com
API_UPSTREAM=https://api.lms.example.com

ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
SERVICE_TOKEN_SECRET=
CSRF_SECRET=
PHONE_OTP_HASH_SECRET=

AUTH_DATABASE_URL=postgresql://user:password@db.example.com:5432/auth?sslmode=require
ORGANIZATION_DATABASE_URL=postgresql://user:password@db.example.com:5432/organization?sslmode=require
ACADEMIC_DATABASE_URL=postgresql://user:password@db.example.com:5432/academic?sslmode=require
BILLING_DATABASE_URL=postgresql://user:password@db.example.com:5432/billing?sslmode=require
NOTIFICATION_DATABASE_URL=postgresql://user:password@db.example.com:5432/notification?sslmode=require
REDIS_URL=rediss://default:password@redis.example.com:6379
RABBITMQ_URL=amqps://user:password@rabbitmq.example.com:5671

AUTH_SERVICE_URL=https://auth.internal.example.com
ORGANIZATION_SERVICE_URL=https://organization.internal.example.com
ACADEMIC_SERVICE_URL=https://academic.internal.example.com
BILLING_SERVICE_URL=https://billing.internal.example.com
NOTIFICATION_SERVICE_URL=https://notification.internal.example.com

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://lms.example.com/auth/callback
GOOGLE_OAUTH_STATE_COOKIE_NAME=lms_google_oauth_state
GOOGLE_OAUTH_STATE_COOKIE_PATH=/

REFRESH_COOKIE_NAME=lms_refresh
REFRESH_COOKIE_PATH=/api/v1/auth
# Use "none" when frontend and gateway are on different sites (for example Vercel + Render).
REFRESH_COOKIE_SAME_SITE=none

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

SMS_PROVIDER_URL=https://sms-provider.example/v1/messages
SMS_PROVIDER_TOKEN=

WEB_PUSH_PROVIDER_URL=
WEB_PUSH_PROVIDER_TOKEN=
SENTRY_DSN=

FEATURE_BILLING_ENABLED=false
PROVIDER_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# Used when STRIPE_PRICE_ID is not set. Amount is in the smallest currency unit.
STRIPE_CHECKOUT_UNIT_AMOUNT=2900
STRIPE_CHECKOUT_CURRENCY=USD
QPAY_API_URL=https://qpay.example.com
QPAY_CLIENT_ID=
QPAY_CLIENT_SECRET=
QPAY_WEBHOOK_SECRET=
QPAY_CALLBACK_URL=https://lms.example.com/api/payments/qpay/webhook

FILE_SIGNING_SECRET=
FILE_DOWNLOAD_BASE_URL=https://lms.example.com/api/uploads/download
FILE_STORAGE_DIRECTORY=/data/private-uploads
FILE_STORAGE_AT_REST_ENCRYPTED=true
MALWARE_SCAN_MODE=required
MALWARE_SCANNER_URL=https://scanner.example.com/scan

ONBOARDING_RATE_LIMIT_MAX=5
ONBOARDING_RATE_LIMIT_WINDOW_MINUTES=60
ENABLE_DEMO_USERS_SEED=false
ENABLE_DEMO_ACADEMIC_SEED=false
DEMO_ORGANIZATION_SLUG=mongol-erdem
DEMO_SEED_PASSWORD=password123
BACKUP_RESTORE_DRILL_EVIDENCE_URL=
