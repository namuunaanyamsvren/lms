# REQUIRED unless marked OPTIONAL. Values shown are development defaults.
PORT=8002
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/lms_db?schema=organization"
REDIS_URL="redis://localhost:6379"
RABBITMQ_URL="amqp://lms_app:change-me@localhost:5672"
# REQUIRED SECRETS: 256-bit base64url; inject, do not commit values.
ACCESS_TOKEN_SECRET=""
SERVICE_TOKEN_SECRET=""
ACCESS_TOKEN_EXPIRES_IN="15m"
ALLOWED_ORIGINS="http://localhost:5173"
AUTH_SERVICE_URL="http://localhost:8001"
ACADEMIC_SERVICE_URL="http://localhost:8003"
ENABLE_DEMO_TENANT_FALLBACK=false
ONBOARDING_RATE_LIMIT_MAX=50
ONBOARDING_RATE_LIMIT_WINDOW_MINUTES=60
