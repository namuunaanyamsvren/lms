# REQUIRED unless marked OPTIONAL. Values shown are development defaults.
PORT=8000
NODE_ENV=development
# REQUIRED SECRET: 256-bit base64url; must match the auth-service access secret.
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRES_IN=15m
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
CSRF_HEADER_NAME=x-csrf-token
REDIS_URL=redis://localhost:6379
AUTH_SERVICE_URL=http://localhost:8001
ORGANIZATION_SERVICE_URL=http://localhost:8002
ACADEMIC_SERVICE_URL=http://localhost:8003
BILLING_SERVICE_URL=http://localhost:8004
NOTIFICATION_SERVICE_URL=http://localhost:8005
