# REQUIRED unless marked OPTIONAL. Values shown are safe development defaults only.
PORT=8001
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/lms_db?schema=auth"
REDIS_URL="redis://localhost:6379"
RABBITMQ_URL="amqp://lms_app:change-me@localhost:5672"
# REQUIRED SECRETS: independent 256-bit base64url values; no defaults.
ACCESS_TOKEN_SECRET=""
REFRESH_TOKEN_SECRET=""
SERVICE_TOKEN_SECRET=""
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"
REFRESH_COOKIE_NAME="lms_refresh"
REFRESH_COOKIE_PATH="/api/v1/auth"
REFRESH_COOKIE_DOMAIN=""
REFRESH_COOKIE_SAME_SITE="lax"
FRONTEND_URL="http://localhost:5173"
ALLOWED_ORIGINS="http://localhost:5173"
CSRF_COOKIE_NAME="lms_csrf"
CSRF_HEADER_NAME="x-csrf-token"
CSRF_SECRET=""
ORGANIZATION_SERVICE_URL="http://localhost:8002"
ACADEMIC_SERVICE_URL="http://localhost:8003"
AUTH_AUDIT_RETENTION_DAYS=365
AUTH_SESSION_RETENTION_DAYS=90
AUTH_TOKEN_RETENTION_DAYS=30
AUTH_OUTBOX_RETENTION_DAYS=30
AUTH_RETENTION_INTERVAL_MS=86400000
PASSWORD_MIN_LENGTH="12"
PASSWORD_COMPROMISED_CHECK_ENABLED="false"
PASSWORD_COMPROMISED_CHECK_FAILURE_MODE="allow"
PASSWORD_COMPROMISED_API_URL="https://api.pwnedpasswords.com"
PASSWORD_RESET_EXPIRES_IN="30m"
PASSWORD_RESET_RATE_WINDOW_SECONDS="900"
PASSWORD_RESET_IP_MAX_REQUESTS="20"
PASSWORD_RESET_ACCOUNT_MAX_REQUESTS="5"
LOGIN_ATTEMPT_WINDOW_SECONDS="900"
LOGIN_IP_MAX_ATTEMPTS="50"
LOGIN_ACCOUNT_MAX_ATTEMPTS="10"
LOGIN_COMBINED_MAX_ATTEMPTS="5"
LOGIN_LOCK_THRESHOLD="5"
LOGIN_LOCK_DURATION_SECONDS="900"
BRUTE_FORCE_STORE_FAILURE_MODE="deny"
AUTH_TRUST_PROXY_HOPS="1"
VERIFICATION_RESEND_COOLDOWN_SECONDS="60"
PHONE_DEFAULT_COUNTRY_CODE="+976"
PHONE_OTP_HASH_SECRET=""
PHONE_OTP_LENGTH="6"
PHONE_OTP_EXPIRES_SECONDS="300"
PHONE_OTP_MAX_ATTEMPTS="5"
PHONE_OTP_RESEND_COOLDOWN_SECONDS="60"
PHONE_OTP_RATE_WINDOW_SECONDS="3600"
PHONE_OTP_PHONE_MAX_SENDS="5"
PHONE_OTP_IP_MAX_SENDS="20"
SMS_PROVIDER="mock"
SMS_PROVIDER_TIMEOUT_MS="5000"
# Production provider credentials. Keep real values in the deployment secret store.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:5173/auth/callback"
GOOGLE_OAUTH_STATE_COOKIE_NAME="lms_google_oauth_state"
GOOGLE_OAUTH_STATE_COOKIE_PATH="/"
