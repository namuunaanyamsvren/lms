# Shared package reference. Runtime services use their own templates.
# REQUIRED SECRETS: independent 256-bit base64url values; no defaults.
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
# OPTIONAL defaults.
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://lms_app:change-me@localhost:5672
EVENT_CONSUMER_PREFETCH=20
EVENT_CONSUMER_RECONNECT_MS=5000
EVENT_MAX_RETRIES=5
EVENT_RETRY_BASE_MS=1000
EVENT_RETRY_MAX_MS=300000
EVENT_INBOX_STALE_MS=900000
EVENT_INBOX_BUSY_RETRY_MS=5000
EVENT_RECONCILIATION_INTERVAL_MS=60000
