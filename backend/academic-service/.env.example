# REQUIRED unless marked OPTIONAL. Values shown are development defaults.
PORT=8003
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/lms_db?schema=academic"
REDIS_URL="redis://localhost:6379"
RABBITMQ_URL="amqp://lms_app:change-me@localhost:5672"
EVENT_MAX_RETRIES=5
EVENT_RETRY_BASE_MS=1000
EVENT_RETRY_MAX_MS=300000
EVENT_INBOX_STALE_MS=900000
EVENT_RECONCILIATION_INTERVAL_MS=60000
# REQUIRED SECRETS: 256-bit base64url; inject, do not commit values.
ACCESS_TOKEN_SECRET=""
SERVICE_TOKEN_SECRET=""
ACCESS_TOKEN_EXPIRES_IN="15m"
ALLOWED_ORIGINS="http://localhost:5173"
AUTH_SERVICE_URL="http://localhost:8001"
ORGANIZATION_SERVICE_URL="http://localhost:8002"
BILLING_SERVICE_URL="http://localhost:8004"
NOTIFICATION_SERVICE_URL="http://localhost:8005"
# File admission and signed delivery. Development may disable scanning; production
# startup requires MALWARE_SCAN_MODE=required and HTTPS scanner/public endpoints.
MALWARE_SCAN_MODE="disabled"
MALWARE_SCANNER_URL=""
MALWARE_SCAN_TIMEOUT_MS=10000
FILE_SIGNING_SECRET=""
FILE_DOWNLOAD_BASE_URL="http://localhost:8000/api/uploads/download"
FILE_STORAGE_DIRECTORY="/tmp/lms-academic-uploads"
FILE_STORAGE_AT_REST_ENCRYPTED="false"
# Certificate PDFs are never public objects. Mount this directory on encrypted,
# durable private storage in production.
CERTIFICATE_STORAGE_PATH="/tmp/lms-private-certificates"
PUBLIC_APP_URL="http://localhost:5173"
# OPTIONAL: required only when R2 storage is enabled.
CLOUDFLARE_R2_ACCOUNT_ID=""
CLOUDFLARE_R2_ACCESS_KEY="your-access-key"
CLOUDFLARE_R2_SECRET_KEY=""
CLOUDFLARE_R2_BUCKET="lms-assets"
# Recurring timetable times are local wall-clock values in this IANA timezone.
SCHEDULE_TIMEZONE=Asia/Ulaanbaatar
