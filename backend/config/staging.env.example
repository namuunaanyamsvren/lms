# Staging policy; inject all credentials from the deployment secret manager.
NODE_ENV=staging
FEATURE_BILLING_ENABLED=false
TENANT_BASE_DOMAIN=staging.example.com
ALLOWED_ORIGINS=https://staging.example.com
FRONTEND_URL=https://staging.example.com
GOOGLE_CLIENT_ID=secret-store-reference
GOOGLE_CLIENT_SECRET=secret-store-reference
GOOGLE_REDIRECT_URI=https://staging.example.com/auth/callback
GOOGLE_OAUTH_STATE_COOKIE_PATH=/
SMS_PROVIDER=twilio
PASSWORD_COMPROMISED_CHECK_FAILURE_MODE=deny
