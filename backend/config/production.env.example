# Production policy; never store live values in this file.
NODE_ENV=production
FEATURE_BILLING_ENABLED=false
TENANT_BASE_DOMAIN=lms.example.com
ALLOWED_ORIGINS=https://app.example.com
FRONTEND_URL=https://app.example.com
GOOGLE_CLIENT_ID=secret-store-reference
GOOGLE_CLIENT_SECRET=secret-store-reference
GOOGLE_REDIRECT_URI=https://app.example.com/auth/callback
GOOGLE_OAUTH_STATE_COOKIE_PATH=/
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=secret-store-reference
SMTP_PASS=secret-store-reference
SMTP_FROM=LMS Notifications <notifications@example.com>
SMTP_SECURE=false
SMS_PROVIDER_URL=https://sms-provider.example/v1/messages
SMS_PROVIDER_TOKEN=secret-store-reference
WEB_PUSH_PROVIDER_URL=https://push-provider.example/v1/send
WEB_PUSH_PROVIDER_TOKEN=secret-store-reference
PROVIDER_WEBHOOK_SECRET=secret-store-reference
STRIPE_SECRET_KEY=sk_live_secret-store-reference
STRIPE_WEBHOOK_SECRET=whsec_secret-store-reference
STRIPE_PRICE_ID=price_live_secret-store-reference
STRIPE_WEBHOOK_URL=https://app.example.com/api/v1/payments/stripe/webhook
QPAY_API_URL=https://qpay.example.com
QPAY_CLIENT_ID=secret-store-reference
QPAY_CLIENT_SECRET=secret-store-reference
QPAY_WEBHOOK_SECRET=secret-store-reference
QPAY_CALLBACK_URL=https://app.example.com/api/payments/qpay/webhook
SENTRY_DSN=https://public@example.com/1
BACKUP_RESTORE_DRILL_EVIDENCE_URL=https://runbooks.example.com/evidence/latest-restore-drill
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_BASE_MS=30000
NOTIFICATION_RETRY_MAX_MS=3600000
NOTIFICATION_RETENTION_DAYS=90
PASSWORD_COMPROMISED_CHECK_FAILURE_MODE=deny
REQUIRE_INTERNAL_TLS=true
AUTH_DATABASE_URL=postgresql://lms:secret@postgres.internal:5432/lms_db?schema=auth&sslmode=verify-full
ORGANIZATION_DATABASE_URL=postgresql://lms:secret@postgres.internal:5432/lms_db?schema=organization&sslmode=verify-full
ACADEMIC_DATABASE_URL=postgresql://lms:secret@postgres.internal:5432/lms_db?schema=academic&sslmode=verify-full
BILLING_DATABASE_URL=postgresql://lms:secret@postgres.internal:5432/lms_db?schema=billing&sslmode=verify-full
NOTIFICATION_DATABASE_URL=postgresql://lms:secret@postgres.internal:5432/lms_db?schema=notification&sslmode=verify-full
REDIS_URL=rediss://redis.internal:6380
RABBITMQ_URL=amqps://lms:secret@rabbitmq.internal:5671
AUTH_SERVICE_URL=https://auth-service.internal
ORGANIZATION_SERVICE_URL=https://organization-service.internal
ACADEMIC_SERVICE_URL=https://academic-service.internal
BILLING_SERVICE_URL=https://billing-service.internal
NOTIFICATION_SERVICE_URL=https://notification-service.internal
FILE_SIGNING_SECRET=secret-store-reference-at-least-32-bytes
FILE_DOWNLOAD_BASE_URL=https://api.example.com/api/uploads/download
FILE_STORAGE_DIRECTORY=/var/lib/lms/private-uploads
FILE_STORAGE_AT_REST_ENCRYPTED=true
MALWARE_SCAN_MODE=required
MALWARE_SCANNER_URL=https://malware-scanner.internal/v1/scan
