# REQUIRED unless marked OPTIONAL. Values shown are development defaults.
PORT=8005
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/lms_db?schema=notification"
REDIS_URL="redis://localhost:6379"
RABBITMQ_URL="amqp://lms_app:change-me@localhost:5672"
# OPTIONAL SMTP group: if SMTP_HOST is set, credentials must come from a secret store.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="notifications@lms.com"
SMTP_PASS=""
SMTP_FROM="LMS Notifications <notifications@lms.com>"
SMTP_SECURE=false
SMTP_MAX_CONNECTIONS=5
SMS_PROVIDER="http"
SMS_PROVIDER_URL=""
SMS_PROVIDER_TOKEN=""
WEB_PUSH_PROVIDER_URL=""
WEB_PUSH_PROVIDER_TOKEN=""
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_BASE_MS=30000
NOTIFICATION_RETRY_MAX_MS=3600000
NOTIFICATION_DELIVERY_POLL_MS=15000
NOTIFICATION_RETENTION_DAYS=90
PROVIDER_WEBHOOK_SECRET=""
# REQUIRED SECRET: 256-bit base64url; must match auth-service.
ACCESS_TOKEN_SECRET=""
ACCESS_TOKEN_EXPIRES_IN="15m"
ALLOWED_ORIGINS="http://localhost:5173"
