# Required production secrets. Generate independent, high-entropy values.
POSTGRES_USER=postgres
# REQUIRED. Database credentials; inject from the deployment secret manager in staging/production.
POSTGRES_PASSWORD=
# REQUIRED. Never use RabbitMQ's guest account outside an isolated local environment.
RABBITMQ_USER=
RABBITMQ_PASSWORD=
# Local development host ports; containers still use 5672/15672 internally.
RABBITMQ_HOST_PORT=5673
RABBITMQ_MANAGEMENT_HOST_PORT=15673
# REQUIRED. Independent 256-bit base64url secrets. Generate each with: openssl rand -base64 32
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
SERVICE_TOKEN_SECRET=
CSRF_SECRET=
PHONE_OTP_HASH_SECRET=
FILE_SIGNING_SECRET=

# OPTIONAL defaults.
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# REQUIRED in production. Comma-separated exact origins; wildcard (*) is rejected.
ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
FRONTEND_HTTP_PORT=8080
TENANT_BASE_DOMAIN=localhost
API_UPSTREAM=https://api.lms.example.com

# Managed production data plane. Production overlay requires TLS URLs.
AUTH_DATABASE_URL=postgresql://auth_user:secret@db.example.com:5432/lms_auth?sslmode=require
ORGANIZATION_DATABASE_URL=postgresql://organization_user:secret@db.example.com:5432/lms_organization?sslmode=require
ACADEMIC_DATABASE_URL=postgresql://academic_user:secret@db.example.com:5432/lms_academic?sslmode=require
BILLING_DATABASE_URL=postgresql://billing_user:secret@db.example.com:5432/lms_billing?sslmode=require
NOTIFICATION_DATABASE_URL=postgresql://notification_user:secret@db.example.com:5432/lms_notification?sslmode=require
REDIS_URL=rediss://default:secret@redis.example.com:6379
RABBITMQ_URL=amqps://lms:secret@rabbitmq.example.com:5671
AUTH_SERVICE_URL=https://auth.internal.example.com
ORGANIZATION_SERVICE_URL=https://organization.internal.example.com
ACADEMIC_SERVICE_URL=https://academic.internal.example.com
BILLING_SERVICE_URL=https://billing.internal.example.com
NOTIFICATION_SERVICE_URL=https://notification.internal.example.com

# Browser deployment. Override the URLs above with the production origin.
REFRESH_COOKIE_NAME=lms_refresh
REFRESH_COOKIE_PATH=/api/v1/auth
REFRESH_COOKIE_DOMAIN=
REFRESH_COOKIE_SAME_SITE=lax
CSRF_COOKIE_NAME=lms_csrf
CSRF_HEADER_NAME=x-csrf-token

# Production SMS delivery
SMS_PROVIDER=twilio
SMS_PROVIDER_TIMEOUT_MS=5000
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Password compromise lookup policy
PASSWORD_COMPROMISED_CHECK_ENABLED=true
PASSWORD_COMPROMISED_CHECK_FAILURE_MODE=allow

# Google OAuth. Keep the client secret in the deployment secret manager.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback
GOOGLE_OAUTH_STATE_COOKIE_NAME=lms_google_oauth_state
GOOGLE_OAUTH_STATE_COOKIE_PATH=/

# Billing provider. Keep disabled until live Stripe keys and webhook handling
# are verified in staging.
FEATURE_BILLING_ENABLED=false
PROVIDER_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# File admission. Production requires the scanner and HTTPS object delivery.
MALWARE_SCAN_MODE=required
MALWARE_SCANNER_URL=https://malware-scanner.internal/v1/scan
MALWARE_SCAN_TIMEOUT_MS=10000
FILE_DOWNLOAD_BASE_URL=https://api.example.com/api/uploads/download
FILE_STORAGE_DIRECTORY=/var/lib/lms/private-uploads
FILE_STORAGE_AT_REST_ENCRYPTED=true

# Notification providers
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
WEB_PUSH_PROVIDER_URL=
WEB_PUSH_PROVIDER_TOKEN=

# Public organization onboarding abuse protection. Development default is
# intentionally higher so validation mistakes do not lock you out while testing.
ONBOARDING_RATE_LIMIT_MAX=50
ONBOARDING_RATE_LIMIT_WINDOW_MINUTES=60

# Set true after service mesh/private PKI endpoints are configured. The
# production overlay enables this fail-fast validation by default.
REQUIRE_INTERNAL_TLS=false
# Emergency test-lab escape hatch only; never set in staging/production.
ALLOW_INSECURE_INTERNAL_TRANSPORT_FOR_TESTING=false

# Privacy/security record cleanup defaults.
AUTH_AUDIT_RETENTION_DAYS=365
AUTH_SESSION_RETENTION_DAYS=90
AUTH_TOKEN_RETENTION_DAYS=30
AUTH_OUTBOX_RETENTION_DAYS=30

# Self-hosted PostgreSQL base-backup/PITR profile.
POSTGRES_BACKUP_INTERVAL_SECONDS=86400
POSTGRES_BACKUP_RETENTION_DAYS=14
# Restore drill only: ISO-8601 recovery target. Empty means latest recoverable point.
PITR_TARGET_TIME=

# Development seed is hard-blocked in production. This escape hatch is only
# for an explicitly disposable, non-loopback development/test database.
ALLOW_NONLOCAL_DEV_SEED=false
RESET_DEV_SEED_PASSWORD=false
DEV_SEED_PASSWORD=
