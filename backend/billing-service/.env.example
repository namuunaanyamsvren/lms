# REQUIRED unless marked OPTIONAL. Values shown are development defaults.
PORT=8004
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/lms_db?schema=billing"
REDIS_URL="redis://localhost:6379"
RABBITMQ_URL="amqp://lms_app:change-me@localhost:5672"
BILLING_OUTBOX_INTERVAL_MS=5000
EVENT_MAX_RETRIES=5
EVENT_RETRY_BASE_MS=1000
EVENT_RETRY_MAX_MS=300000
EVENT_INBOX_STALE_MS=900000
EVENT_RECONCILIATION_INTERVAL_MS=60000
# REQUIRED SECRET: 256-bit base64url; must match auth-service.
ACCESS_TOKEN_SECRET=""
ACCESS_TOKEN_EXPIRES_IN="15m"
ALLOWED_ORIGINS="http://localhost:5173"
# OPTIONAL: required only when R2 invoice storage is enabled.
CLOUDFLARE_R2_ACCOUNT_ID="your-r2-account-id"
CLOUDFLARE_R2_ACCESS_KEY="your-r2-access-key"
CLOUDFLARE_R2_SECRET_KEY=""
CLOUDFLARE_R2_INVOICE_BUCKET="lms-invoices"
